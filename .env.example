NODE_ENV=production
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
# Generate with: node ace generate:key --show
APP_KEY=
# Public URL, https in production
APP_URL=https://panel.example.com
SESSION_DRIVER=cookie
LIMITER_STORE=database

# MySQL host: replace your-mysql-host (host name or IP reachable from the container;
# see "MySQL on the same machine" in the README). There is no mysql service in docker-compose.
# Panel database (full rights on this database)
PANEL_DB_HOST=your-mysql-host
PANEL_DB_PORT=3306
PANEL_DB_USER=retake_panel
PANEL_DB_PASSWORD=
PANEL_DB_DATABASE=retake_panel

# RetakeV4 plugin database (SELECT/INSERT/UPDATE on player_loadout, SELECT on retake_catalog)
RETAKE_DB_HOST=your-mysql-host
RETAKE_DB_PORT=3306
RETAKE_DB_USER=retake_panel
RETAKE_DB_PASSWORD=
RETAKE_DB_DATABASE=retakev4

# Optional
PANEL_RETAKE_SERVER=default
PANEL_MODULES=loadouts
PANEL_ADMINS=
STEAM_API_KEY=
PANEL_LOCALE=en

# Public domain served by Caddy (docker-compose)
PANEL_DOMAIN=panel.example.com
